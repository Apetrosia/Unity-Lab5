.screen {
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: #050505;
    padding: 1%;
    color: #00ff00;
}

.header {
    flex-direction: row;
    justify-content: space-between;
    border-bottom-width: 2px;
    border-bottom-color: #00ff00;
    border-bottom-style: solid;
    padding-bottom: 1%;
    margin-bottom: 1%;
}

.title {
    font-size: 20px;
    color: #00ff00;
}

.status-text {
    font-size: 20px;
    color: #ff3333;
}

.main-content {
    flex-direction: row;
    flex-grow: 1;
    width: 100%;
    min-height: 0;
}

.left-panel {
    flex: 1;
    border-width: 2px;
    border-color: #00ff00;
    border-style: solid;
    padding: 1%;
    background-color: #0a0a0a;
    margin-right: 1%;
    min-height: 0;
}

.right-panel {
    flex: 1;
    border-width: 2px;
    border-color: #00ff00;
    border-style: solid;
    padding: 1%;
    background-color: #0a0a0a;
    min-height: 0;
}

.panel-title {
    font-size: 16px;
    margin-bottom: 1%;
    color: #00cc00;
    border-bottom-width: 1px;
    border-bottom-color: #00ff00;
    border-bottom-style: solid;
    padding-bottom: 0.5%;
}

.process-list {
    flex-grow: 1;
}

.process-item {
    font-size: 14px;
    margin-bottom: 0.5%;
}

.bar-container {
    width: 100%;
    height: 20px;
    background-color: #001100;
    border-width: 2px;
    border-color: #00ff00;
    border-style: solid;
    margin-bottom: 1%;
}

.bar-fill {
    width: 50%;
    height: 100%;
    background-color: #00ff00;
}

.bar-fill.upload {
    background-color: #00aaff;
}

.bar-text {
    font-size: 14px;
    margin-bottom: 2%;
    color: #00ff00;
}

.footer {
    flex-direction: column;
    border-top-width: 2px;
    border-top-color: #00ff00;
    border-top-style: solid;
    padding-top: 1%;
    margin-top: 1%;
    height: 25%;
    flex-shrink: 0;
}

.log {
    flex-grow: 1;
    font-size: 14px;
    color: #00ff00;
    white-space: pre-wrap;
    overflow: hidden;
}

.command-input {
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: #00ff00;
    border-bottom-style: solid;
    color: #00ff00;
    font-size: 16px;
    height: 30px;
}