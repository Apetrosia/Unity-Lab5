.screen {
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: #050505;
    padding: 1%;
    color: #00ff00;
}

.header {
    flex-direction: row;
    justify-content: space-between;
    border-bottom-width: 2px;
    border-bottom-color: #00ff00;
    padding-bottom: 1%;
    margin-bottom: 1%;
}

.title {
    font-size: 20px;
    color: #00ff00;
}

.status-text {
    font-size: 20px;
    color: #ff3333;
}

.main-content {
    flex-direction: row;
    flex-grow: 1;
    width: 100%;
    min-height: 0;
}

.left-panel {
    flex: 1;
    border-width: 2px;
    border-color: #00ff00;
    padding: 1%;
    background-color: #0a0a0a;
    margin-right: 1%;
    min-height: 0;
}

.right-panel {
    flex: 1;
    border-width: 2px;
    border-color: #00ff00;
    padding: 1%;
    background-color: #0a0a0a;
    min-height: 0;
}

.panel-title {
    font-size: 16px;
    margin-bottom: 1%;
    color: #00cc00;
    border-bottom-width: 1px;
    border-bottom-color: #00ff00;
    padding-bottom: 0.5%;
}

.process-list {
    flex-grow: 1;
}

.bar-container {
    width: 100%;
    height: 20px;
    background-color: #001100;
    border-width: 2px;
    border-color: #00ff00;
    margin-bottom: 1%;
}

.bar-fill {
    width: 50%;
    height: 100%;
    background-color: #00ff00;
}

.bar-fill.upload {
    background-color: #00aaff;
}

.bar-text {
    font-size: 14px;
    margin-bottom: 2%;
    color: #00ff00;
}

.footer {
    flex-direction: column;
    border-top-width: 2px;
    border-top-color: #00ff00;
    padding-top: 1%;
    margin-top: 1%;
    height: 25%;
    flex-shrink: 0;
}

.log {
    flex-grow: 1;
    font-size: 14px;
    color: #00ff00;
    white-space: pre-wrap;
    overflow: hidden;
}

#command-input {
    flex-grow: 1;
    height: 20px;               /* высота строки, как у метки */
    margin: 0;
    padding: 0;
    background-color: #000000;
}

#command-input > #unity-text-input {
    height: 20px;
    margin: 0;
    padding: 0;
    background-color: #000000;
    border-width: 0;
    border-radius: 0;
    font-size: 16px;            /* как у метки "C:\PROMETHEUS>" */
    color: #00ff00;
    -unity-text-align: upper-left;
}

#command-input .unity-text-element {
    font-size: 16px;                  /* тот же размер, что у "C:\PROMETHEUS>" */
    color: #00ff00;
    background-color: rgba(0, 0, 0, 0);
    height: 20px;                     /* фиксированная высота строки */
    margin: 0;
    padding: 0;
    -unity-text-align: upper-left;
}

/* Фокус и наведение, чтобы тема не перебивала цвета */
#command-input:focus > #unity-text-input,
#command-input:hover > #unity-text-input,
#command-input > #unity-text-input:focus,
#command-input > #unity-text-input:hover {
    background-color: #000000;
    border-width: 0;
    color: #00ff00;
}

/* Цвет курсора и выделения (работает как стиль USS в Unity 2022.1+) */
#command-input {
    --unity-cursor-color: #00ff00;
    --unity-selection-color: rgba(0, 255, 0, 0.35);
}

    .process-item {
    padding: 5px;
    margin-bottom: 5px;
    border-bottom-width: 1px;
    border-bottom-color: #004400;
}

.process-label {
    font-size: 14px;
    color: #00ff00;
}

/* Выделенный процесс: лаймовый фон, чёрный текст */
.process-item--selected {
    background-color: #00ff00;
}

.process-item--selected .process-label {
    color: #000000;
}

/* Ошибка в поле ввода */
#command-input.input-error > #unity-text-input {
    color: #ff3333;
}

/* Скрываем скроллбар, но оставляем прокрутку */
#process-list {
    overflow: scroll;
}

#process-list > .unity-scroll-view__vertical-scroller {
    display: none;
}

#process-list > .unity-scroll-view__horizontal-scroller {
    display: none;
}