<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <Style src="../USS/TerminalStyle.uss" />
    <!-- Внешний контейнер: центрирует содержимое -->
    <ui:VisualElement name="outer-container" style="flex-direction: column; justify-content: center; align-items: center; width: 100%; height: 100%; background-color: #000000;">

        <!-- Внутренний контейнер: фиксированный размер -->
        <ui:VisualElement name="screen-container" class="screen" style="width: 1200px; height: 700px; flex-shrink: 0;">

            <!-- Шапка -->
            <ui:VisualElement name="header" class="header">
                <ui:Label text="TERMINAL BREACH v0.9.1" class="title" />
                <ui:Label text="STATUS: CRITICAL" name="status-text" class="status-text" />
            </ui:VisualElement>

            <!-- Основная область -->
            <ui:VisualElement name="main-content" class="main-content">

                <!-- Левая панель: процессы -->
                <ui:VisualElement name="left-panel" class="left-panel">
                    <ui:Label text="ACTIVE PROCESSES" class="panel-title" />

                    <ui:VisualElement name="process-header" class="process-header">
                        <ui:Label text="#" class="process-label col-id" />
                        <ui:Label text="PROCESS" class="process-label col-name" />
                        <ui:Label text="CPU" class="process-label col-cpu" />
                        <ui:Label text="RAM" class="process-label col-ram" />
                    </ui:VisualElement>

                    <ui:ScrollView name="process-list" class="process-list" />

                    <!-- Строка кэша (не процесс, не убивается) -->
                    <ui:VisualElement name="cache-row" class="process-item process-item--cache">
                        <ui:Label text="-" class="process-label col-id" />
                        <ui:Label text="SYSTEM_CACHE" class="process-label col-name" />
                        <ui:Label text="-" class="process-label col-cpu" />
                        <ui:Label name="cache-ram-label" text="0.0%" class="process-label col-ram" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Правая панель: индикаторы -->
                <ui:VisualElement name="right-panel" class="right-panel">
                    <ui:Label text="CPU USAGE" class="panel-title" />
                    <ui:VisualElement name="cpu-bar-container" class="bar-container">
                        <ui:VisualElement name="cpu-fill" class="bar-fill" />
                    </ui:VisualElement>
                    <ui:Label name="cpu-text" text="0%" class="bar-text" />

                    <ui:Label text="MEMORY USAGE" class="panel-title" />
                    <ui:VisualElement name="ram-bar-container" class="bar-container">
                        <ui:VisualElement name="ram-fill" class="bar-fill" />
                    </ui:VisualElement>
                    <ui:Label name="ram-text" text="512 / 1024 KB (50%)" class="bar-text" />

                    <ui:Label text="UPLOAD PROGRESS" class="panel-title" />
                    <ui:VisualElement name="upload-bar-container" class="bar-container">
                        <ui:VisualElement name="upload-fill" class="bar-fill upload" />
                    </ui:VisualElement>
                    <ui:Label name="upload-text" text="0%" class="bar-text" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Подвал -->
            <ui:VisualElement name="footer" class="footer">
                <ui:Label name="log-output" text="" class="log" />
                <ui:VisualElement name="input-line" style="flex-direction: row; align-items: center; width: 100%; margin-top: 10px;">
                    <ui:Label text="C:\TERMINAL BREACH>" style="color: #00ff00; font-size: 16px; height: 20px; margin: 0 5px 0 0; padding: 0; -unity-text-align: upper-left; flex-shrink: 0;" />
                    <ui:TextField name="command-input" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>